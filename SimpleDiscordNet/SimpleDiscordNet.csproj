<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>SimpleDiscordDotNet</AssemblyName>
        <Version>1.11.0</Version>

        <IsPackable>true</IsPackable>

        <!-- Package metadata -->
        <PackageId>SimpleDiscordDotNet</PackageId>
        <Title>SimpleDiscordNet</Title>
        <Authors>SimpleDiscordNet Contributors</Authors>
        <Description>A tiny, dependency-free Discord bot SDK for .NET 10 with bucket-aware rate limiting, slash commands, components, modals, and Native AOT support.
        Join our community on Discord: https://discord.gg/2KrUPCgh</Description>
        <PackageTags>discord;bot;api;gateway;rest;slash-commands;discord-bot;aot;native-aot;trimming;rate-limiting</PackageTags>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://simpledotnet.com/projects/simple-discord-dotnet/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Simple-DotNet/SimpleDiscordDotNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>v1.11.0: Adds attribute modals, polls, threads and forum posts, layout messages (Components V2), command translation, DM and user-install attributes, message forwarding, member and message search, bulk bans and application emojis. Fixes entity parsing, DM and uncached-channel messages, gateway reconnect and resume, per-resource rate limits, command parameters and context menu commands. Sharding reworked: cluster traffic is now authenticated, so upgrade all nodes together. Distributed sharding is experimental. Includes behavior changes, so re-sync your commands and read the upgrade notes: https://github.com/Simple-DotNet/SimpleDiscordDotNet#v1110</PackageReleaseNotes>

        <!-- AOT compatibility -->
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SimpleDiscordNet.Tests" />
        <InternalsVisibleTo Include="SimpleDiscordNet.AotSmoke" />
    </ItemGroup>

    <!-- Reference for build-time usage only -->
    <ItemGroup>
        <!-- Use the generator during local builds as an analyzer -->
        <ProjectReference Include="..\SimpleDiscordNet.Generators\SimpleDiscordNet.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- Pack the generator from its real output path, which differs between AnyCPU and x64 builds -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="PackGenerator">
        <MSBuild Projects="..\SimpleDiscordNet.Generators\SimpleDiscordNet.Generators.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);Platform=$(Platform)"
                 RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" ItemName="_GeneratorAssembly" />
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_GeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
